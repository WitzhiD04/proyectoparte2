<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    API Gateway de la plataforma (AD-04, DA-12, DA-15, DA-16, DA-20; DT-07): única entrada de la consola y de la API.
    YARP enruta con el catálogo de rutas (rutas.json); la identidad la valida el mismo validador JWT que usan los
    servicios (comun/Plataforma.Comun.Seguridad, que trae JwtBearer y Microsoft.IdentityModel).
  -->
  <ItemGroup>
    <PackageReference Include="Yarp.ReverseProxy" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\comun\Plataforma.Comun.Salud\Plataforma.Comun.Salud.csproj" />
    <ProjectReference Include="..\..\..\comun\Plataforma.Comun.Seguridad\Plataforma.Comun.Seguridad.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="rutas.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Plataforma.Gateway.Pruebas" />
  </ItemGroup>
</Project>
