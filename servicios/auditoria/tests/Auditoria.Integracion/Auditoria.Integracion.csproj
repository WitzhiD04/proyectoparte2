<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Pruebas de Auditoría contra PostgreSQL 18 y RabbitMQ 4.4 reales (Testcontainers) con la topología de
    despliegue/bus: migraciones y particiones, permisos de solo inserción, interpretación de cada evento del catálogo,
    consumo idempotente del atraso de q.auditoria, QA-15 (b y c) y detección de huecos (R-02). Requieren Docker.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Auditoria.Api\Auditoria.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Un ejemplo válido de cada evento del contrato. Se enlaza (no se copia) para que siga al contrato. -->
    <Compile Include="..\..\..\..\comun\pruebas\Plataforma.Comun.Pruebas\Contrato\EjemplosContrato.cs" Link="Contrato\EjemplosContrato.cs" />
  </ItemGroup>
</Project>
