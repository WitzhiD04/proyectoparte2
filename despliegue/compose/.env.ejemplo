# Copie este archivo a .env (en esta misma carpeta) para cambiar puertos o claves. Sin .env se usan estos valores,
# que son solo para desarrollo local (aviso A-15 del paso 1). No suba un .env con claves reales al repositorio.

# Puertos publicados en el computador.
# Gateway (consola y API): una réplica en cada puerto.
PUERTO_WEB=8080
PUERTO_WEB_REPLICA=8081
PUERTO_KEYCLOAK=8180
PUERTO_RABBIT=15672
PUERTO_MINIO=9001

# PostgreSQL: dueño (lo usa solo el migrador) y roles de aplicación (los crea el migrador).
POSTGRES_CLAVE=postgres_local
RECONSTRUCCION_APP_CLAVE=reconstruccion_local
PROGRAMA_APP_CLAVE=programa_local
EVALUACION_DANOS_APP_CLAVE=evaluacion_danos_local
ADAPTADOR_SE2_APP_CLAVE=adaptador_se2_local
ADAPTADOR_SE6_APP_CLAVE=adaptador_se6_local
ADAPTADOR_SE7_APP_CLAVE=adaptador_se7_local
REPLICADOR_CLAVE=replicador_local
GESTION_DESASTRES_APP_CLAVE=gestion_desastres_local
CONSULTA_APP_CLAVE=consulta_local
AUDITORIA_APP_CLAVE=auditoria_local
CONSULTA_DANOS_APP_CLAVE=consulta_danos_local

# Bus. Si cambia estas claves, regenere las definiciones con las mismas variables:
#   BUS_CLAVE_RECONSTRUCCION=... python despliegue/bus/generar_definiciones.py
BUS_COOKIE=cookie-local-plataforma
BUS_CLAVE_RECONSTRUCCION=reconstruccion_local
BUS_CLAVE_CONSULTA_PROGRAMA=consulta_programa_local
BUS_CLAVE_EVALUACION_DANOS=evaluacion_danos_local
BUS_CLAVE_ADAPTADOR_SE2=adaptador_se2_local
BUS_CLAVE_ADAPTADOR_SE6=adaptador_se6_local
BUS_CLAVE_ADAPTADOR_SE7=adaptador_se7_local
BUS_CLAVE_GESTION_DESASTRES=gestion_desastres_local
BUS_CLAVE_CONSULTA=consulta_local
BUS_CLAVE_AUDITORIA=auditoria_local
BUS_CLAVE_CONSULTA_DANOS=consulta_danos_local

# Auditoría: un hueco en la secuencia de un productor se reporta si persiste más que este plazo (ATAM R-02).
AUDITORIA_PLAZO_HUECO_SEGUNDOS=60

# Consulta de Daños: umbrales de la alarma de la bandeja de revisión (ATAM R-08, DA-09).
CONSULTA_DANOS_UMBRAL_CONFLICTOS=50
CONSULTA_DANOS_UMBRAL_HORAS=24

# MinIO.
MINIO_USUARIO=minioadmin
MINIO_CLAVE=minioadmin

# Adaptador de SE-6 (DA-11): tamaño máximo del lote y ventana de acumulación en segundos.
ADAPTADOR_SE6_TAMANO_LOTE=10
ADAPTADOR_SE6_VENTANA_LOTE_SEGUNDOS=2

# Adaptador de SE-7 (DA-11): intervalo de la consulta periódica de la entrada, y cada cuánto el simulador de SE-7
# asigna contratistas y avanza las obras.
ADAPTADOR_SE7_INTERVALO_SEGUNDOS=30
SIM_SE7_INTERVALO_SEGUNDOS=20

# Identidad y proveedor OIDC Keycloak (DT-08, DA-15).
KEYCLOAK_CLAVE_ADMIN=admin_local
KEYCLOAK_HOSTNAME=http://localhost:8180
# Jwt por omisión: con el gateway delante, los servicios solo aceptan el token (DA-15). Encabezados es para probar
# un servicio directamente, sin gateway.
IDENTIDAD_MODO=Jwt
IDENTIDAD_EMISOR=http://localhost:8180/realms/plataforma
IDENTIDAD_AUDIENCIA=gateway
IDENTIDAD_METADATOS=http://keycloak:8080/realms/plataforma/.well-known/openid-configuration
