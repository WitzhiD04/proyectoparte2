<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Adaptadores de salida y de entrada asíncrona: persistencia con EF Core (y sus migraciones), MinIO, la bandeja de
    salida hacia el bus y el consumidor de la proyección. La mensajería y el contrato vienen de comun.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Minio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Reconstruccion.Aplicacion\Reconstruccion.Aplicacion.csproj" />
    <ProjectReference Include="..\..\..\..\comun\Plataforma.Comun.Eventos\Plataforma.Comun.Eventos.csproj" />
    <ProjectReference Include="..\..\..\..\comun\Plataforma.Comun.Mensajeria\Plataforma.Comun.Mensajeria.csproj" />
    <ProjectReference Include="..\..\..\..\comun\Plataforma.Comun.Migraciones\Plataforma.Comun.Migraciones.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Datos de prueba que el migrador carga con la opción de sembrar. -->
    <EmbeddedResource Include="Persistencia\Migraciones\Sql\siembra-datos-prueba.sql" LogicalName="siembra-datos-prueba.sql" />
  </ItemGroup>
</Project>
