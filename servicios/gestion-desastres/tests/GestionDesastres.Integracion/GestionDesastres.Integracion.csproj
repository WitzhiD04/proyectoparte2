<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Pruebas de Gestión de Desastres contra PostgreSQL con PostGIS y RabbitMQ reales (Testcontainers), con la topología de
    despliegue/bus y el servicio completo levantado en memoria (WebApplicationFactory). Requieren Docker.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\GestionDesastres.Api\GestionDesastres.Api.csproj" />
  </ItemGroup>
</Project>
