<?xml version="1.0" encoding="UTF-8"?>
<!--
  Adaptador de SE-8 (Comunicación y notificación) en Jakarta EE 11 (AD-66, CON-9).
  Dos módulos:
    adaptador  WAR que corre en WildFly 42 (un solo despliegue)
    migrador   JAR con Flyway que crea la base adaptador_se8, su rol y sus tablas (convención *-migrador)
  Compilar y probar:  mvn -f adaptadores/adaptador-se8-jee/pom.xml verify
  Las pruebas de integración (sufijo IT) usan Testcontainers y necesitan Docker; sin Docker se omiten.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>plataforma.adaptadores</groupId>
  <artifactId>adaptador-se8-jee</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>Adaptador de SE-8 (Jakarta EE)</name>

  <modules>
    <module>migrador</module>
    <module>adaptador</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- Versiones del servidor (WildFly 42.0.0.Final): las del alcance provided deben coincidir con sus módulos. -->
    <jakartaee.version>11.0.0</jakartaee.version>
    <mp-config.version>3.1.3</mp-config.version>
    <jackson.version>2.21.7</jackson.version>
    <hibernate.version>7.4.13.Final</hibernate.version>
    <!-- Empaquetadas en el WAR o el JAR -->
    <rabbitmq-jms.version>3.9.1</rabbitmq-jms.version>
    <json-schema.version>1.5.9</json-schema.version>
    <flyway.version>13.13.0</flyway.version>
    <postgresql.version>42.7.14</postgresql.version>
    <!-- Pruebas -->
    <junit.version>5.14.4</junit.version>
    <mockito.version>5.24.0</mockito.version>
    <testcontainers.version>2.0.5</testcontainers.version>
    <slf4j.version>2.0.17</slf4j.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.14.0</version>
          <configuration>
            <compilerArgs><arg>-Xlint:all,-processing,-serial</arg></compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>3.6.1</version>
          <executions>
            <execution>
              <goals><goal>integration-test</goal><goal>verify</goal></goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-war-plugin</artifactId>
          <version>3.5.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>3.6.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.3.1</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
