# Copie este archivo a .env (en esta misma carpeta) para cambiar puertos o claves. Sin .env se usan estos valores,
# que son solo para desarrollo local (aviso A-15 del paso 1). No suba un .env con claves reales al repositorio.

# Puertos publicados en el computador.
PUERTO_WEB=8080
PUERTO_RABBIT=15672
PUERTO_MINIO=9001

# PostgreSQL: dueño (lo usa solo el migrador) y roles de aplicación (los crea el migrador).
POSTGRES_CLAVE=postgres_local
RECONSTRUCCION_APP_CLAVE=reconstruccion_local
PROGRAMA_APP_CLAVE=programa_local
EVALUACION_DANOS_APP_CLAVE=evaluacion_danos_local
ADAPTADOR_SE2_APP_CLAVE=adaptador_se2_local
REPLICADOR_CLAVE=replicador_local

# Bus. Si cambia estas claves, regenere las definiciones con las mismas variables:
#   BUS_CLAVE_RECONSTRUCCION=... python despliegue/bus/generar_definiciones.py
BUS_COOKIE=cookie-local-plataforma
BUS_CLAVE_RECONSTRUCCION=reconstruccion_local
BUS_CLAVE_CONSULTA_PROGRAMA=consulta_programa_local
BUS_CLAVE_EVALUACION_DANOS=evaluacion_danos_local
BUS_CLAVE_ADAPTADOR_SE2=adaptador_se2_local

# MinIO.
MINIO_USUARIO=minioadmin
MINIO_CLAVE=minioadmin
