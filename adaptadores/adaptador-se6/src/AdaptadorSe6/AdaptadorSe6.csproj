<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Adaptador de SE-6, sistema financiero externo (DA-11; AD-03, AD-05, AD-09, AD-25, AD-36, AD-37; E-10).
    Solo salida, con envío por lote (Cuadro 14: "envío por lote") e idempotencia por idProyecto + versionHistorial.
    La misma imagen corre en modo "salida" (consume q.salida.se6, acumula en lotes por tamaño o tiempo y entrega a
    SE-6 con la resiliencia común y EV-23) y en modo "migrar" (esquema se6 en la base compartida "adaptadores").
    No tiene appsettings.json: toda su configuración llega por variables de entorno (ver README).
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\comun\Plataforma.Comun.Eventos\Plataforma.Comun.Eventos.csproj" />
    <ProjectReference Include="..\..\..\..\comun\Plataforma.Comun.Mensajeria\Plataforma.Comun.Mensajeria.csproj" />
    <ProjectReference Include="..\..\..\..\comun\Plataforma.Comun.Migraciones\Plataforma.Comun.Migraciones.csproj" />
    <ProjectReference Include="..\..\..\..\comun\Plataforma.Comun.Salud\Plataforma.Comun.Salud.csproj" />
    <ProjectReference Include="..\..\..\..\comun\Plataforma.Comun.Adaptadores\Plataforma.Comun.Adaptadores.csproj" />
  </ItemGroup>
</Project>
