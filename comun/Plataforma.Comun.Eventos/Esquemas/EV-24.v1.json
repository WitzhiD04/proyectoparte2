{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plataforma.local/esquemas/EV-24.v1.json",
  "title": "EV-24 Avance o contratista reportado por SE-7",
  "description": "Extensión aditiva (E-04). Productor: adaptador de SE-7. Consumidor: Reconstrucción, que lo registra con procedencia SE-7.",
  "type": "object",
  "required": ["idProyecto", "tipo", "avance", "contratista", "instanteExterno", "claveOrigen", "marcaAvance"],
  "properties": {
    "idProyecto": { "$ref": "comun.v1.json#/$defs/uuid" },
    "tipo": { "$ref": "comun.v1.json#/$defs/tipoReporteExterno" },
    "avance": { "anyOf": [{ "$ref": "comun.v1.json#/$defs/porcentaje" }, { "type": "null" }] },
    "contratista": { "type": ["string", "null"] },
    "instanteExterno": { "$ref": "comun.v1.json#/$defs/instante" },
    "claveOrigen": { "$ref": "comun.v1.json#/$defs/textoNoVacio" },
    "marcaAvance": { "$ref": "comun.v1.json#/$defs/textoNoVacio" }
  },
  "if": { "properties": { "tipo": { "const": "AVANCE" } } },
  "then": { "properties": { "avance": { "$ref": "comun.v1.json#/$defs/porcentaje" } } },
  "else": { "properties": { "contratista": { "$ref": "comun.v1.json#/$defs/textoNoVacio" } } }
}
