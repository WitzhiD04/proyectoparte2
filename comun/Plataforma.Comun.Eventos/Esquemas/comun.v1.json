{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plataforma.local/esquemas/comun.v1.json",
  "title": "Definiciones comunes del contrato de eventos",
  "description": "Tipos compartidos por los esquemas de los eventos. Los objetos admiten propiedades adicionales para que un consumidor de la versión 1 acepte los campos que agregue una evolución aditiva (ATAM R-03).",
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "instante": { "type": "string", "format": "date-time", "description": "ISO-8601 con zona horaria explícita (SRS Cuadro 7, atributo 12)." },
    "fecha": { "type": "string", "format": "date" },
    "textoNoVacio": { "type": "string", "minLength": 1 },
    "monto": { "type": "number", "minimum": 0, "description": "Pesos colombianos." },
    "porcentaje": { "type": "number", "minimum": 0, "maximum": 100 },
    "version": { "type": "integer", "minimum": 1 },
    "codigoMunicipio": { "type": "string", "pattern": "^[0-9]{5}$", "description": "DIVIPOLA del DANE." },
    "codigoDepartamento": { "type": "string", "pattern": "^[0-9]{2}$", "description": "DIVIPOLA del DANE." },
    "nivelDano": { "enum": ["SIN_DANO", "LEVE", "MODERADO", "GRAVE", "DESTRUCCION_TOTAL"] },
    "estadoDesastre": { "enum": ["DETECTADO", "REGISTRADO", "EN_EVALUACION", "EN_ATENCION", "EN_RECUPERACION", "EN_RECONSTRUCCION", "CERRADO"] },
    "severidad": { "enum": ["NIVEL_1", "NIVEL_2", "NIVEL_3", "NIVEL_4"] },
    "origenDesastre": { "enum": ["MANUAL", "EXTERNO"] },
    "estadoProyecto": { "enum": ["FORMULADO", "APROBADO", "EN_EJECUCION", "FINALIZADO", "CANCELADO"] },
    "alcanceProyecto": { "enum": ["MUNICIPAL", "REGIONAL", "NACIONAL"] },
    "tipoCambioProyecto": { "enum": ["CREACION", "PRESUPUESTO", "FUENTE", "RESPONSABLE", "CRONOGRAMA", "CONTRATISTA", "ESTADO", "AVANCE", "COSTO", "DOCUMENTO"] },
    "estadoEvaluacion": { "enum": ["PRELIMINAR", "REGISTRADA", "EN_CONFLICTO", "VALIDADA", "RECHAZADA", "DUPLICADO"] },
    "estadoValidacion": { "enum": ["VALIDADA", "RECHAZADA", "PENDIENTE"] },
    "tipoConflicto": { "enum": ["VERSION", "DUPLICADO"] },
    "estadoRevision": { "enum": ["PENDIENTE", "RESUELTO"] },
    "decisionConflicto": { "enum": ["PREVALECE_ENTRANTE", "PREVALECE_VIGENTE", "FUSIONAR", "RECHAZAR_DUPLICADO"] },
    "motivoActualizacion": { "enum": ["ACTUALIZACION", "ASOCIACION"] },
    "estadoIntegracion": { "enum": ["CERRADO", "ABIERTO", "SEMIABIERTO"] },
    "tipoReporteExterno": { "enum": ["AVANCE", "CONTRATISTA"] },
    "capaGeografica": { "enum": ["MUNICIPIOS", "BARRIOS", "ZONAS_RIESGO"] },
    "confianza": { "enum": ["ALTA", "MEDIA", "BAJA"] },
    "ubicacion": {
      "type": "object",
      "required": ["lat", "lon"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "cronograma": {
      "type": "object",
      "required": ["inicio", "fin"],
      "properties": {
        "inicio": { "$ref": "#/$defs/fecha" },
        "fin": { "$ref": "#/$defs/fecha" }
      }
    },
    "geometria": {
      "type": "object",
      "description": "Geometría GeoJSON (RFC 7946).",
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "enum": ["Point", "LineString", "Polygon", "MultiPolygon"] },
        "coordinates": { "type": "array" }
      }
    },
    "division": {
      "type": "object",
      "required": ["codigo", "nombre", "codigoPadre", "geometria"],
      "properties": {
        "codigo": { "type": "string", "pattern": "^[0-9]{2}([0-9]{3})?$" },
        "nombre": { "$ref": "#/$defs/textoNoVacio" },
        "codigoPadre": { "anyOf": [{ "$ref": "#/$defs/codigoDepartamento" }, { "type": "null" }] },
        "geometria": { "$ref": "#/$defs/geometria" }
      }
    },
    "resumenProyecto": {
      "type": "object",
      "required": ["idDesastre", "nombre", "estado", "presupuesto", "costoEjecutado", "avance", "version"],
      "properties": {
        "idDesastre": { "$ref": "#/$defs/uuid" },
        "nombre": { "$ref": "#/$defs/textoNoVacio" },
        "estado": { "$ref": "#/$defs/estadoProyecto" },
        "presupuesto": { "anyOf": [{ "$ref": "#/$defs/monto" }, { "type": "null" }] },
        "costoEjecutado": { "$ref": "#/$defs/monto" },
        "avance": { "$ref": "#/$defs/porcentaje" },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "instantaneaEvaluacion": {
      "type": "object",
      "required": ["idEvaluacion", "idActivo", "idDesastre", "tipoActivo", "nivelDano", "ubicacion", "precisionM", "codigoMunicipio", "estadoEvaluacion", "versionEvaluacion", "versionActivo"],
      "properties": {
        "idEvaluacion": { "$ref": "#/$defs/uuid" },
        "idActivo": { "$ref": "#/$defs/uuid" },
        "idDesastre": { "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "tipoActivo": { "$ref": "#/$defs/textoNoVacio" },
        "nivelDano": { "$ref": "#/$defs/nivelDano" },
        "ubicacion": { "$ref": "#/$defs/ubicacion" },
        "precisionM": { "type": "number", "minimum": 0 },
        "codigoMunicipio": { "$ref": "#/$defs/codigoMunicipio" },
        "estadoEvaluacion": { "$ref": "#/$defs/estadoEvaluacion" },
        "versionEvaluacion": { "$ref": "#/$defs/version" },
        "versionActivo": { "$ref": "#/$defs/version" }
      }
    }
  }
}
